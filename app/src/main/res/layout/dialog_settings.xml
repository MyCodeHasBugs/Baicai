<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加速镜像"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="每行一个镜像前缀，留空则直连。App 会并发测速自动选最快的，失败自动切换。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMirrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="https://ghfast.top/"
            android:inputType="textMultiLine|textUri"
            android:minLines="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="性能"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUploadConc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="上传并发（1-8，默认 4）"
            android:inputType="number" />

        <EditText
            android:id="@+id/etDownloadThreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="下载线程（1-16，默认 6）"
            android:inputType="number" />

        <EditText
            android:id="@+id/etShardMb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="上传分片大小 MB（4-64，默认 24）"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="云端编译服务已内置，无需填写账号或 Token。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>