<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="仓库与 Token"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Owner，例如 MyCodeHasBugs"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="仓库名，例如 Baicai"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="分支（默认 main）"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etWorkflow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="workflow 文件名（cloud-build.yml）"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="GitHub Token（Contents + Actions 读写）"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="加速镜像（每行一个，可留空走直连）"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMirrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="https://ghfast.top/"
            android:inputType="textMultiLine|textUri"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="性能"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUploadConc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="上传并发（1-8，默认 4）"
            android:inputType="number" />

        <EditText
            android:id="@+id/etDownloadThreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="下载线程（1-16，默认 6）"
            android:inputType="number" />

        <EditText
            android:id="@+id/etShardMb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="上传分片大小 MB（4-64，默认 24）"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Token 只保存在本机加密存储里，不会写入日志。建议使用只授权单个仓库的细粒度 Token。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>